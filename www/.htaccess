#Bad Bots
RewriteEngine On
RewriteCond %{HTTP_USER_AGENT} ElevenlabsCrawler [NC]
RewriteRule .* - [F,L]

RewriteEngine On
RewriteCond %{HTTP_USER_AGENT} snapscout [NC]
RewriteRule .* - [F,L]

RewriteEngine On
RewriteCond %{HTTP_USER_AGENT} img2dataset [NC]
RewriteRule .* - [F,L]

RewriteEngine On
RewriteCond %{HTTP_USER_AGENT} TikTokSpider [NC]
RewriteRule .* - [F,L]

RewriteEngine On
RewriteCond %{HTTP_USER_AGENT} Bytespider [NC]
RewriteRule .* - [F,L]

Options -Indexes

Header always set X-Robots-Tag "noimageai"
Header always set X-Robots-Tag "noai"

<IfModule mod_rewrite.c>
    RewriteEngine On

    #   Naughty bots who ignore robots.txt
    RewriteCond %{HTTP_USER_AGENT}  (Baidu|Semrush|ElevenlabsCrawler|DotBot) [NC]

    #   Mustn't try to access these paths
    RewriteCond %{REQUEST_URI} ^/(api|edit) [NC]

    #   Slap them with a payment request.
    RewriteRule ^ - [R=402,L]
</IfModule>

<IfModule mod_rewrite.c>
        RewriteEngine On
        RewriteBase /

###     BLOCKED	IPs
        RewriteCond %{REMOTE_ADDR} "=192.0.2.1"
        RewriteRule ^ - [R=402,L]
###     /BLOCKED IPs

        RewriteCond %{HTTPS} off
        RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

        RewriteCond %{THE_REQUEST} /public/([^\s?]*) [NC]
        RewriteRule ^ %1 [L,NE,R=302]

        RewriteRule ^((?!public/).*)$ public/$1 [L,NC]
</IfModule>

ErrorDocument 402 "Payment Required - Access Denied. You must follow the instructions at https://raw.githubusercontent.com/openbenches/openbenches.org/refs/heads/master/www/public/llms.txt to get unblocked."

#	https://www.inmotionhosting.com/support/website/force-hsts-using-htaccess/
Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
#	https://scotthelme.co.uk/hardening-your-http-response-headers/
Header always set Content-Security-Policy "upgrade-insecure-requests;"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
#	https://scotthelme.co.uk/a-new-security-header-referrer-policy/
Header always set Referrer-Policy "no-referrer-when-downgrade"

